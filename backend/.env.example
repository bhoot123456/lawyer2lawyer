# ─────────────────────────────────────────────────────────────
# Lawyer2Lawyer Backend — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file — it contains secrets.
#
# Production: ALL values below MUST be provided via your deployment's
# secret manager / environment configuration. Do not use development
# defaults in production.

# ── MongoDB Connection ─────────────────────────────────────────
# Production: use the Atlas/replica-set connection string.
# Do NOT fall back to localhost in production.
MONGO_URI=mongodb://USER:PASS@cluster.mongodb.net/lawyer2lawyer?ssl=true&replicaSet=...&authSource=admin

# ── JWT Secrets ────────────────────────────────────────────────
# Production: use long, random secrets (min 32 characters).
JWT_SECRET=generate-a-long-random-string-here
JWT_REFRESH_SECRET=generate-a-long-random-string-here
# Optional TTL overrides (defaults: 15m access, 30d refresh)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ── Server ─────────────────────────────────────────────────────
PORT=5000
# NODE_ENV must be "production" in production deployments.
# NODE_ENV=production

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins for production.
# In production, this MUST include your frontend/admin origins.
# Example: CORS_ORIGIN=https://app.lawyer2lawyer.com,https://admin.lawyer2lawyer.com
CORS_ORIGIN=https://app.lawyer2lawyer.example,https://admin.lawyer2lawyer.example

# ── OpenRouter AI ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-real-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
# HTTP-Referer sent to OpenRouter (should be your real site domain)
# OPENROUTER_HTTP_REFERER=https://app.lawyer2lawyer.com
# Request timeout in ms (default: 15000)
# OPENROUTER_TIMEOUT_MS=15000

# ── Rate Limiting ──────────────────────────────────────────────
# AI endpoints (defaults: 60 req / 60s per IP)
# AI_RATE_LIMIT_ENABLED=true
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=60

# Auth endpoints (defaults: 10 req / 60s per IP — stricter)
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10

# ── Judicial Intelligence Engine ───────────────────────────────
# JIE_JOB_INTERVAL_MS=86400000
