# ─────────────────────────────────────────────────────────────
# Lawyer2Lawyer Mobile — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development.
# NEVER commit the real `.env` file — it is in .gitignore.
#
# For production builds, set EXPO_PUBLIC_API_URL via the EAS
# build profile (see eas.json) or EAS secrets. Production builds
# MUST use an HTTPS API URL — never localhost/127.0.0.1/10.0.2.2.

# ── Backend API URL ───────────────────────────────────────────
# Development (local backend):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:5000/api
#
# Production (REPLACE with your real domain):
#   EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000/api
