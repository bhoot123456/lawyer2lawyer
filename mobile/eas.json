{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lawyer2lawyer-production.up.railway.app/api"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lawyer2lawyer-production.up.railway.app/api"
      }
    }
  }
}
